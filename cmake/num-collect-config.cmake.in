@PACKAGE_INIT@

if(NOT TARGET num_collect::num_collect)
    include(CMakeFindDependencyMacro)
    find_dependency(Threads)
    find_dependency(fmt)
    find_dependency(Eigen3)
    find_dependency(cpp-hash-tables)
    find_dependency(concurrentqueue)
    find_dependency(nanoflann)
    find_dependency(Boost COMPONENTS math)
    find_dependency(tomlplusplus)
    if("@NUM_COLLECT_USE_OPENMP@")
        find_dependency(OpenMP)
    endif()

    include(${CMAKE_CURRENT_LIST_DIR}/num-collect-targets.cmake)
endif()

check_required_components(num-collect)
