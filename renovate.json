{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch updates",
      "groupSlug": "minor-and-patch-updates"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
